{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moni",
  "mainBinaryName": "Moni",
  "version": "0.1.1",
  "identifier": "dev.moni.clock",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moni",
        "width": 980,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Moni",
    "shortDescription": "Moni clock telemetry",
    "longDescription": "Feeds CPU, GPU and thermal telemetry to the Moni ESP32 five-screen clock from boot, over USB or WiFi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/moni-service.exe": "moni-service.exe",
      "../sensors/publish/*": "sensors/",
      "../../firmware/moni-si-hai.bin": "firmware/moni-si-hai.bin",
      "vendor/PawnIO_setup.exe": "tools/PawnIO_setup.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
